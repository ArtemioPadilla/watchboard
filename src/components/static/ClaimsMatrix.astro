---
import type { Claim } from '../../lib/schemas';
import { claimStatusMeta } from '../../lib/claim-status';

interface Props {
  claims: Claim[];
}

const { claims } = Astro.props;
---
<section class="section fade-in" id="sec-contested">
  <div class="section-header">
    <span class="section-num">06</span>
    <h2 class="section-title">Contested Claims Matrix</h2>
    <span class="section-count">{claims.length} claims &middot; click to expand</span>
  </div>
  <div class="claims-list">
    {claims.map((c, i) => {
      const st = claimStatusMeta(c);
      return (
      <details class="claim-card-collapsible" open={i === 0} data-claim-status={st.status}>
        <summary class="claim-summary">
          <span class="claim-summary-main">
            <span class={`claim-status claim-status-${st.tone}`} title={`Status: ${st.label}${c.status ? '' : ' (inferred)'}`} aria-label={`Status: ${st.label}`}>
              <span aria-hidden="true">{st.icon}</span> {st.label}
            </span>
            <span class="claim-question-text">{c.question}</span>
          </span>
          <span class="claim-expand-icon" aria-hidden="true"></span>
        </summary>
        <div class="claim-body">
          <div class="claim-sides">
            <div class="claim-side">
              <div class="claim-side-label a">Source A: {c.sideA.label}</div>
              <div class="claim-side-text">{c.sideA.text}</div>
            </div>
            <div class="claim-side">
              <div class="claim-side-label b">Source B: {c.sideB.label}</div>
              <div class="claim-side-text">{c.sideB.text}</div>
            </div>
          </div>
          <div class="claim-resolution">&#9878; RESOLUTION: {c.resolution}</div>
        </div>
      </details>
      );
    })}
  </div>
</section>
